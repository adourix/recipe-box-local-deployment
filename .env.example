# Copy to .env before starting: cp .env.example .env
# Generate strong secrets with: openssl rand -hex 32

# --- Telegram bot (optional for website-only use) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
WORKER_SECRET=
ALLOWED_TELEGRAM_USER_ID=

# --- Local Supabase API ---
# Bare-metal default: point this at the local API gateway/PostgREST endpoint.
# If your Supabase API is behind Nginx, use that local URL instead.
SUPABASE_URL=http://127.0.0.1:8000
# URL used by browser clients; for LAN use the server LAN address.
SUPABASE_PUBLIC_URL=http://192.168.1.254:8000
SUPABASE_SERVICE_ROLE_KEY=replace-with-generated-service-role-jwt
NEXT_PUBLIC_SUPABASE_URL=http://192.168.1.254:8000
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-generated-anon-jwt

# --- Gemini recipe extraction ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# --- Website URL used in Telegram reply links ---
APP_BASE_URL=http://192.168.1.254:3004
# Bare-metal app listens directly on 127.0.0.1:3004.
INTERNAL_APP_URL=http://127.0.0.1:3004

# --- Local resolver ---
RESOLVER_URL=http://127.0.0.1:8081
RESOLVER_HOST=127.0.0.1
RESOLVER_PORT=8081
RESOLVER_SECRET=replace-with-a-long-random-value
# Prefer a file for Netscape-format cookies; it supports multiline cookie content.
RESOLVER_COOKIES_FILE=
# Legacy single-variable form; suitable only for one-line cookie content.
RESOLVER_COOKIES=

# --- Editing / maintenance API keys ---
EDIT_KEY=replace-with-a-long-random-value
CRON_SECRET=replace-with-a-different-long-random-value
